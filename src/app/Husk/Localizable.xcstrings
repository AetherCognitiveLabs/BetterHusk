    },
    "The app's own native code (%@) stopped with %@. It most likely needs something from Android that BetterHusk does not provide yet, or does something iOS does not allow.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用自身的原生代码（%@）因 %@ 而停止。它很可能需要 Android 中 BetterHusk 尚未提供的能力，或做了 iOS 不允许的操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eigene native Code der App (%@) wurde mit %@ beendet. Er braucht höchstwahrscheinlich etwas von Android, das BetterHusk noch nicht bereitstellt, oder tut etwas, das iOS nicht erlaubt."
          }
        }
      }
    },
    "The app's video is DRM-protected (Widevine), which only certified Android devices can decrypt. Unprotected video plays; protected video stays black.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该应用的视频受 DRM 保护（Widevine），只有经过认证的 Android 设备才能解密。未受保护的视频可正常播放，受保护的视频将保持黑屏。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video der App ist DRM-geschützt (Widevine), was nur zertifizierte Android-Geräte entschlüsseln können. Ungeschütztes Video läuft; geschütztes bleibt schwarz."
          }
        }
      }
    },
    "The download failed: %@": {
