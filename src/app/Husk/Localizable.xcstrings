        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste wird auf den Datenträger geschrieben, sodass sie schon auf dem Bildschirm ist, bevor Android "
          }
        }
      }
    },
    "The list is written to disk, so it is on screen before Android has finished starting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表会写入磁盘，因此在 Android 完成启动前即可显示。"
          }
