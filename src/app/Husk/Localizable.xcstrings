    "Saves the emulator once it settles, so later starts take seconds.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在模拟器稳定后保存，之后启动只需几秒。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert den Emulator, sobald er sich eingependelt hat, sodass spätere Starts nur Sekunden dauern."
          }
        }
      }
    },
    "Saves, settings and caches the game made here are deleted.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏在此产生的存档、设置和缓存都会被删除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherstände, Einstellungen und Caches, die das Spiel hier angelegt hat, werden gelöscht."
          }
        }
      }
    },
    "Saving Android — the screen will freeze briefly": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存 Android——屏幕会短暂冻结"
