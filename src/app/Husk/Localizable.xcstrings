          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts aufgezeichnet, was meist bedeutet, dass iOS BetterHusk wegen zu hohen Speicherverbrauchs beendet hat oder BetterHusk über den App-Umschalter geschlossen wurde."
          }
        }
      }
    },
    "Noto Sans CJK, the font Android uses for these languages. Games and apps that draw their own text (Unity, Flutter, ": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
