      }
    },
    "The language apps and games inside BetterHusk see. BetterHusk itself follows your iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BetterHusk 内应用和游戏所见到的语言。BetterHusk 自身跟随 iPhone 设置。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache, die Apps und Spiele in BetterHusk sehen. BetterHusk selbst folgt deinem iPhone."
          }
        }
      }
    },
    "The list is written to disk, so it is on screen before Android ": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表会写入磁盘，因此在 Android"
