    "App reports": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用报告"
          }
        }
      }
    },
    "Appearance": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "Apps and games open in a window you can move, resize and minimise to a dock, like LiveContainer's multitasking. ": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用和游戏会在可移动、可缩放、可最小化到 Dock 的窗口中打开，类似 LiveContainer 的多任务。"
          }
        }
      }
    },
    "Apps and games open in a window you can move, resize and minimise to a dock, like LiveContainer's multitasking. Each app can override this in its own settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用和游戏会在可移动、可调大小、可最小化到停靠栏的窗口中打开，类似 LiveContainer 的多任务。每个应用可在自己的设置中覆盖此行为。"
          }
        }
      }
    },
    "Architecture": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "架构"
          }
        }
      }
    },
    "Ask How Games Ran": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "询问游戏运行情况"
          }
        }
      }
    },
    "Ask about Android updates": {
      "extractionState": "manual",
