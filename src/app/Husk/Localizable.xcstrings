    },
    "Tested by the BetterHusk team on an iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 BetterHusk 团队在 iPhone 上实测。"
