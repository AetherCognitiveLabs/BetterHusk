    "Husk's helper reaches this %@'s debugging service through a local VPN. Nothing leaves your %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Husk 的助手通过本地 VPN 访问此 %@ 的调试服务。任何数据都不会离开你的 %@。"
          }
        }
      }
    },
