    "A few quick choices first. Everything here can be changed later in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先做几个快速选择，之后都可以在设置中更改。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst ein paar kurze Entscheidungen. Alles hier lässt sich später in den Einstellungen ändern."
          }
        }
      }
    },
    "A new Android image is available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有新的 Android 镜像可用"
          }
