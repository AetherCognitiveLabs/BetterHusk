    "Attach the sound device": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挂载声音设备"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Automatic follows the system appearance — light, dark and tinted. The others pin ": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”跟随系统外观——浅色、深色与着色；其他选项则固定为"
          }
        }
      }
    },
    "Automatic follows the system appearance — light, dark and tinted. The others pin one look. iOS shows its own confirmation after a change; that alert cannot be turned off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”跟随系统外观——浅色、深色和着色。其余选项固定一种外观。切换后 iOS 会显示自己的确认提示，该提示无法关闭。"
          }
        }
      }
    },
    "Automatic offers the controller for games that cannot be played without one (Unreal Engine games), when no real ": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当没有真实手柄时，为必须使用手柄的游戏（虚幻引擎游戏）自动提供虚拟手柄，"
          }
        }
      }
    },
    "Automatic offers the controller for games that cannot be played without one (Unreal Engine games), when no real controller is connected. Always offers it for any game that understands one. A paired controller is always used.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会在未连接实体手柄时，为没有手柄无法游玩的游戏（虚幻引擎游戏）提供虚拟手柄。“始终”则为所有支持手柄的游戏提供。已配对的手柄始终优先。"
          }
        }
      }
    },
    "Back": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        }
      }
    },
    "Back Up Saves": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份存档"
          }
        }
      }
    },
    "Back to Husk": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回 BetterHusk"
          }
        }
      }
    },
    "Bad APK": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APK 无效"
          }
        }
      }
    },
    "BetterHusk detects %@ as %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BetterHusk 将 %@ 识别为 %@"
          }
        }
      }
    },
    "Boots the guest as soon as Husk opens, when JIT is available.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT 可用时，BetterHusk 一打开就启动 Android 系统。"
          }
        }
      }
    },
    "Both sides must be between 240 and 2560.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽和高都必须介于 240 与 2560 之间。"
          }
        }
      }
    },
    "Browse Files": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览文件"
          }
        }
      }
    },
    "Browse and download apps using an anonymous Aurora guest account, or sign in with your Google account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用匿名 Aurora 访客账户浏览和下载应用，或登录你的 Google 账户。"
          }
        }
      }
    },
    "Build": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建"
          }
        }
      }
    },
    "Built-in JIT is available only on a physical device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置 JIT 仅在实体设备上可用。"
          }
        }
      }
    },
    "Built-in JIT needs iOS 26 or later. Use StikDebug instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置 JIT 需要 iOS 26 或更高版本。请改用 StikDebug。"
          }
        }
      }
    },
    "Built-in StikJIT": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置 StikJIT"
          }
        }
      }
    },
    "CPU": {
      "extractionState": "manual",
