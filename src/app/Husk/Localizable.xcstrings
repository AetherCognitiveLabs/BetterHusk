    "An APK is added to your library when it finishes. Anything else goes into the Shared Storage folder, which games see as their phone storage.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APK 下载完成后会加入游戏库；其他文件会进入共享存储文件夹，游戏会把它当作手机存储。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine APK wird deiner Bibliothek hinzugefügt, sobald sie fertig ist. Alles andere landet im Ordner „Geteilter Speicher“, den Spiele als ihren Telefonspeicher sehen."
          }
        }
      }
    },
    "An Android app. BetterHusk runs its code on its own Java runtime": {
      "localizations": {
