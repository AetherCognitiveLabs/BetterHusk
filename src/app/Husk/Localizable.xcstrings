            "state": "translated",
            "value": "%lld Frame(s) gezeichnet · native Laufzeit"
          }
        }
      }
    },
    "%lld frame(s) posted · driving lifecycle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
