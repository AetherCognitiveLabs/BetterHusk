    "StikDebug": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug"
          }
        }
      }
    },
    "StikDebug is a separate app that attaches to BetterHusk. BetterHusk sends it the JIT script itself, so nothing needs configuring for BetterHusk inside StikDebug.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug 是一个独立应用，会附加到 BetterHusk。BetterHusk 会自行发送 JIT 脚本，因此无需在 StikDebug 内为 BetterHusk 做任何配置。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug ist eine separate App, die sich an BetterHusk anhängt. BetterHusk sendet ihr das JIT-Skript selbst, daher muss in StikDebug nichts für BetterHusk konfiguriert werden."
          }
        }
      }
    },
    "StikDebug is installed, so BetterHusk will open it to turn JIT on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装 StikDebug，BetterHusk 将打开它来启用 JIT。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug ist installiert, daher öffnet BetterHusk es, um JIT einzuschalten."
          }
        }
      }
    },
    "StikDebug is installed, so BetterHusk will open it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
