        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TrollStore ist installiert, daher wird BetterHusk es bitten, JIT zu aktivieren."
          }
        }
      }
    },
    "TrollStore was not found on this %@. It installs on iOS 14.0 to 17.0.": {
