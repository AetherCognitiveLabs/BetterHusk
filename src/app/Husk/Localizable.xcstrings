          }
        }
      }
    },
    "StikDebug, TrollStore and a jailbreak were not found, so BetterHusk will use its built-in helper.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到 StikDebug、TrollStore 或越狱，BetterHusk 将使用内置助手。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug, TrollStore und ein Jailbreak wurden nicht gefunden, daher verwendet BetterHusk seinen eingebauten Helfer."
          }
        }
      }
    },
    "StikJIT (built in)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StikJIT（内置）"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StikJIT (eingebaut)"
          }
        }
      }
    },
    "StikJIT is built into BetterHusk. You can turn JIT on right here — no computer and no other app. Games and Android both need it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StikJIT 已内置于 BetterHusk。你可以直接在这里开启 JIT——无需电脑或其他应用。游戏和 Android 都需要它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StikJIT ist in BetterHusk eingebaut. Du kannst JIT direkt hier einschalten – kein Computer und keine andere App nötig. Spiele und Android brauchen es beide."
          }
        }
