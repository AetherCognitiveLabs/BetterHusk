          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Frame(s) übergeben · treibt den Lebenszyklus an"
          }
        }
      }
    },
    "%lld min · first boot takes 5–15 min": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分钟 · 首次启动需 5–15 分钟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Min. · der erste Start dauert 5–15 Min."
          }
        }
      }
    },
    "%lld of them use tricks the older loader could not handle; the native runtime handles those too, except for optional anti-tamper code, which it leaves out.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中 %lld 个使用了旧版加载器无法处理的技巧；原生运行时也能处理这些，但可选的防篡改代码除外，那部分会被跳过。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld davon nutzen Tricks, die der ältere Loader nicht bewältigen konnte; die native Laufzeit schafft auch diese, bis auf optionalen Anti-Tamper-Code, den sie auslässt."
          }
        }
      }
    },
    "%lld relocations": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 次重定位"
          }
        },
        "de": {
