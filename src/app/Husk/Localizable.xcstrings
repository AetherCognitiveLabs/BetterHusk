          "stringUnit": {
            "state": "translated",
            "value": "1 Pixel pro Punkt. Am schnellsten."
          }
        }
      }
    },
    "1.5 pixels per point.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
