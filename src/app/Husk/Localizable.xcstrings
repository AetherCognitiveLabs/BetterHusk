    "%@, minimised": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，已最小化"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, minimiert"
          }
        }
      }
    },
    "%@. Open the Android screen and check it is running, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。打开 Android 界面确认它正在运行，然后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Öffne den Android-Bildschirm und prüfe, ob es läuft, dann versuche es erneut."
          }
        }
      }
    },
