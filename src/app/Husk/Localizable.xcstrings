            "value": "%lld fps"
          }
        }
      }
    },
    "%lld frame(s) drawn · native runtime": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已绘制 %lld 帧 · 原生运行时"
          }
        },
