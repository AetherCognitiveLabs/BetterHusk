{
  "sourceLanguage": "en",
  "strings": {
    " (and %lld more)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（另有 %lld 项）"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " (und %lld weitere)"
          }
        }
      }
    },
    " and loads its %lld arm64 libraries itself.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，并自行加载其 %lld 个 arm64 库。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " und lädt seine %lld arm64-Bibliotheken selbst."
          }
        }
      }
    },
    " · %@ left": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · 剩余 %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · %@ übrig"
          }
        }
      }
    },
    " · %@/s": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · %@/秒"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · %@/s"
          }
        }
      }
    },
    " · %lld%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld%"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld%"
          }
        }
      }
    },
    " · %lld/%lld files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld/%lld 个文件"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld/%lld Dateien"
          }
        }
      }
    },
    "%@ %@?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@?"
          }
        }
      }
    },
    "%@ (%@). %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）。%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@). %@"
          }
        }
      }
    },
    "%@ (%lld/%lld)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%lld/%lld）"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%lld/%lld)"
          }
        }
      }
    },
    "%@ (HTTP %lld). %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（HTTP %lld）。%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (HTTP %lld). %@"
          }
        }
      }
    },
    "%@ (web app)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（网页应用）"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Web-App)"
          }
        }
      }
    },
    "%@ Orientation and resolution apply the next time the game starts, and a game already running in this session needs BetterHusk closed and opened again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 方向和分辨率将在下次启动游戏时生效；本次会话中已运行的游戏需要关闭并重新打开 BetterHusk。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausrichtung und Auflösung von %@ gelten beim nächsten Spielstart; ein in dieser Sitzung bereits laufendes Spiel erfordert, dass BetterHusk geschlossen und erneut geöffnet wird."
          }
        }
      }
    },
    "%@ after sending %lld bytes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（已发送 %lld 字节后）"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nach dem Senden von %lld Bytes"
          }
        }
      }
    },
    "%@ closed the app on purpose (%@). Apps with anti-tamper or anti-cheat protection do this when they find they are not on a certified Android phone, which BetterHusk cannot pretend to be for them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 主动关闭了应用（%@）。带有防篡改或反作弊保护的应用发现运行环境不是受认证的 Android 手机时会这样做，而 BetterHusk 无法伪装成这种设备。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die App absichtlich geschlossen (%@). Apps mit Manipulations- oder Cheat-Schutz tun das, wenn sie feststellen, dass sie nicht auf einem zertifizierten Android-Telefon laufen – etwas, das BetterHusk ihnen nicht vortäuschen kann."
          }
        }
      }
    },
    "%@ free on this device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备剩余 %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ frei auf diesem Gerät"
          }
        }
      }
    },
    "%@ free on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备剩余 %@。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ frei auf diesem Gerät."
          }
        }
      }
    },
    "%@ has been started in this run of BetterHusk. Close BetterHusk and open it again to restore saves.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在本次 BetterHusk 运行中启动。关闭并重新打开 BetterHusk 才能恢复存档。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde in dieser BetterHusk-Sitzung gestartet. Schließe BetterHusk und öffne es erneut, um Spielstände wiederherzustellen."
          }
        }
      }
    },
    "%@ has not saved anything yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 还没有保存任何内容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat noch nichts gespeichert."
          }
        }
      }
    },
    "%@ is compressed inside its bundle, which BetterHusk cannot unpack yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在包内被压缩，BetterHusk 暂时无法解包。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist innerhalb seines Bundles komprimiert, und BetterHusk kann es noch nicht entpacken."
          }
        }
      }
    },
    "%@ is empty": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 为空"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist leer"
          }
        }
      }
    },
    "%@ is gone from Android.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已从 Android 中移除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist aus Android verschwunden."
          }
        }
      }
    },
    "%@ is ready to launch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已可启动。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereit zum Start."
          }
        }
      }
    },
    "%@ is still loaded, and a game cannot be unloaded once it has started. Close BetterHusk with the button above, then open it again to play %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍在运行，游戏一旦启动便无法卸载。请用上方按钮关闭 BetterHusk，再重新打开即可游玩 %@。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist noch geladen, und ein Spiel kann nach seinem Start nicht mehr entladen werden. Schließe BetterHusk mit der Taste oben und öffne es dann erneut, um %@ zu spielen."
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ von %@"
          }
        }
      }
    },
    "%@ opens by itself once Android has started.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 启动完成后 %@ 会自动打开。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öffnet sich von selbst, sobald Android gestartet ist."
          }
        }
      }
    },
    "%@ update": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 更新"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Update"
          }
        }
      }
    },
    "%@ was started in this session, and a game cannot be unloaded once it has started. Close BetterHusk completely and open it again to run %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在本次会话中启动，游戏一旦启动便无法卸载。请完全关闭 BetterHusk 再重新打开以运行 %@。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde in dieser Sitzung gestartet, und ein Spiel kann nach seinem Start nicht mehr entladen werden. Schließe BetterHusk vollständig und öffne es erneut, um %@ auszuführen."
          }
        }
      }
    },
    "%@ was started in this session. Close BetterHusk completely and open it again to run %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在本次会话中启动。请完全关闭 BetterHusk 再重新打开以运行 %@。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde in dieser Sitzung gestartet. Schließe BetterHusk vollständig und öffne es erneut, um %@ auszuführen."
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
