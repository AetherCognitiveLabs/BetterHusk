    "Downloading Geode %@…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载 Geode %@…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geode %@ wird geladen…"
          }
        }
      }
    },
    "Downloading it replaces the Android system and its pre-booted snapshot (%@), and with them everything inside Android — installed apps included. A snapshot only restores against the image it was saved on, so the two cannot be updated separately.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载会替换 Android 系统及其预启动快照（%@），以及 Android 内的所有内容（包括已安装的应用）。快照只能恢复到生成它的镜像上，因此两者无法分开更新。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download ersetzt das Android-System und seinen vorgebooteten Snapshot (%@) — und mit ihnen alles innerhalb von Android, einschließlich der installierten Apps. Ein Snapshot kann nur auf das Image zurückgespielt werden, auf dem er gespeichert wurde; die beiden lassen sich daher nicht getrennt aktualisieren."
          }
        }
      }
    },
    "Downloading · %@ of %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载中 · %@ / %@"
